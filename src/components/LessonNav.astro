---
import type { CollectionEntry } from 'astro:content';
import { lessonUrl } from '../lib/content';

interface Props {
  prev?: CollectionEntry<'lessons'>;
  next?: CollectionEntry<'lessons'>;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav
      aria-label="Lesson navigation"
      class="mt-12 grid gap-4 border-t border-border pt-8 sm:grid-cols-2"
    >
      {prev ? (
        <a
          href={lessonUrl(prev)}
          class="card group transition-shadow hover:shadow-md"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-muted">
            Previous
          </p>
          <p class="mt-1 font-medium text-ink group-hover:text-accent">
            {prev.data.title}
          </p>
        </a>
      ) : (
        <div />
      )}
      {next ? (
        <a
          href={lessonUrl(next)}
          class="card group text-right transition-shadow hover:shadow-md sm:col-start-2"
        >
          <p class="text-xs font-semibold uppercase tracking-wide text-ink-muted">
            Next
          </p>
          <p class="mt-1 font-medium text-ink group-hover:text-accent">
            {next.data.title}
          </p>
        </a>
      ) : (
        <div />
      )}
    </nav>
  )
}
