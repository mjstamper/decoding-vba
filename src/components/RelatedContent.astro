---
interface RelatedItem {
  title: string;
  href: string;
  summary?: string;
}

interface Props {
  heading?: string;
  items: RelatedItem[];
}

const { heading = 'Related reading', items } = Astro.props;
---

{
  items.length > 0 && (
    <aside class="related-content mt-12 border-t border-border pt-10">
      <h2 class="font-display text-xl font-semibold text-ink">{heading}</h2>
      <ul class="mt-4 space-y-3">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="group block rounded-xl border border-border bg-surface px-4 py-3 transition-shadow hover:shadow-md"
            >
              <span class="font-medium text-ink group-hover:text-accent">{item.title}</span>
              {item.summary && (
                <p class="mt-1 text-sm leading-relaxed text-ink-muted">{item.summary}</p>
              )}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
