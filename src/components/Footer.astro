---
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-ink py-12 text-canvas">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-display text-lg font-semibold">{site.name}</p>
        <p class="mt-2 max-w-sm text-sm text-canvas/70">{site.tagline}</p>
        <p class="mt-4 text-sm text-canvas/70">
          Practical Excel VBA for reporting, validation, and workplace automation.
        </p>
      </div>
      <nav aria-label="Footer">
        <ul class="flex flex-col gap-2 text-sm font-medium text-canvas/85">
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-canvas">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/privacy/" class="transition-colors hover:text-canvas">
              Privacy
            </a>
          </li>
          <li>
            <a href="/terms/" class="transition-colors hover:text-canvas">
              Terms
            </a>
          </li>
        </ul>
      </nav>
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-canvas/15 pt-8 text-xs text-canvas/55">
      <p>Copyright {year} {site.name}. All rights reserved.</p>
      <p>Free lessons on GitHub Pages. Paid courses sold separately.</p>
    </div>
  </div>
</footer>
