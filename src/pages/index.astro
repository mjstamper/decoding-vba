---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackCard from '../components/TrackCard.astro';
import BuyButton from '../components/BuyButton.astro';
import { getCollection } from 'astro:content';
import { site, tracks, checkout } from '../config/site';
import { getLessonsByTrack, lessonUrl } from '../lib/content';

const allLessons = (await getCollection('lessons')).filter((l) => !l.data.draft);
const allArticles = (await getCollection('articles')).filter((a) => !a.data.draft);
const allCourses = (await getCollection('courses')).filter((c) => !c.data.draft);
const featuredCourse = allCourses.find((c) => c.data.featured) ?? allCourses[0];

const trackCounts = {
  beginner: getLessonsByTrack(allLessons, 'beginner').length,
  intermediate: getLessonsByTrack(allLessons, 'intermediate').length,
  advanced: getLessonsByTrack(allLessons, 'advanced').length,
};

const featuredLessons = allLessons.filter((lesson) => lesson.data.featured);
---

<BaseLayout>
  <section class="border-b border-border bg-accent-soft/40">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-24">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent">
        Workplace Excel automation
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        {site.tagline}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">
        Structured free lessons for finance, operations, and reporting teams. Learn VBA
        the practical way: macros you can use on real spreadsheets, not toy examples.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/learn/" class="btn-primary">Browse learning paths</a>
        <a href="/articles/" class="btn-secondary">Read articles</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <div class="mb-8">
      <h2 class="font-display text-2xl font-semibold text-ink">Choose your track</h2>
      <p class="mt-2 text-ink-muted">
        Beginner, Intermediate, and Advanced paths are free. Work through them in order or
        jump to the topics you need.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      <TrackCard track="beginner" lessonCount={trackCounts.beginner} />
      <TrackCard track="intermediate" lessonCount={trackCounts.intermediate} />
      <TrackCard track="advanced" lessonCount={trackCounts.advanced} />
    </div>
  </section>

  {
    featuredLessons.length > 0 && (
      <section class="border-t border-border bg-surface">
        <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
          <h2 class="font-display text-2xl font-semibold text-ink">Start here</h2>
          <p class="mt-2 text-ink-muted">One flagship lesson from each track.</p>
          <ul class="mt-8 grid gap-4 md:grid-cols-3">
            {featuredLessons.map((lesson) => (
              <li>
                <a href={lessonUrl(lesson)} class="card block transition-shadow hover:shadow-md">
                  <p class="text-xs font-semibold uppercase tracking-wide text-accent">
                    {tracks[lesson.data.track].title}
                  </p>
                  <h3 class="mt-2 font-medium text-ink">{lesson.data.title}</h3>
                  <p class="mt-2 text-sm text-ink-muted">{lesson.data.summary}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    allArticles.length > 0 && (
      <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <h2 class="font-display text-2xl font-semibold text-ink">Latest articles</h2>
            <p class="mt-2 text-ink-muted">Deep dives on specific VBA topics.</p>
          </div>
          <a href="/articles/" class="text-sm font-semibold text-accent hover:underline">
            View all
          </a>
        </div>
        <ul class="grid gap-4">
          {allArticles.slice(0, 3).map((article) => (
            <li>
              <a
                href={`/articles/${article.id}/`}
                class="card block transition-shadow hover:shadow-md"
              >
                <h3 class="font-medium text-ink">{article.data.title}</h3>
                <p class="mt-2 text-sm text-ink-muted">{article.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    featuredCourse && (
      <section class="border-t border-border bg-ink text-canvas">
        <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-accent-soft">
            Paid course
          </p>
          <h2 class="mt-3 font-display text-3xl font-semibold">
            {featuredCourse.data.title}
          </h2>
          <p class="mt-4 max-w-2xl text-canvas/75">{featuredCourse.data.summary}</p>
          <p class="mt-4 text-lg font-semibold">{featuredCourse.data.price}</p>
          <div class="mt-6 flex flex-wrap gap-4">
            <BuyButton href={featuredCourse.data.checkoutUrl} />
            <a
              href={`/courses/${featuredCourse.id}/`}
              class="btn-secondary border-canvas/20 bg-transparent text-canvas hover:border-canvas hover:text-canvas"
            >
              Course details
            </a>
          </div>
          <p class="mt-4 text-xs text-canvas/50">{checkout.note}</p>
        </div>
      </section>
    )
  }
</BaseLayout>
