---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../config/site';
import { formatDate, getAllArticleTags, tagUrl } from '../../lib/content';

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
const tags = getAllArticleTags(articles);
---

<BaseLayout
  title={`VBA Articles | ${site.name}`}
  description="In-depth guides on Excel VBA topics for workplace automation."
>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      VBA articles
    </h1>
    <p class="mt-4 text-lg text-ink-muted">
      Complete guides on specific VBA concepts. Use these alongside the structured lesson
      tracks.
    </p>

    {
      tags.length > 0 && (
        <div class="mt-8">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-muted">
            Browse by topic
          </h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li>
                <a
                  href={tagUrl(tag)}
                  class="rounded-full border border-border bg-surface px-3 py-1.5 text-sm font-medium text-ink-muted transition-colors hover:border-accent hover:text-accent"
                >
                  {tag.replace(/-/g, ' ')}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <ul class="mt-10 space-y-4">
      {
        articles.map((article) => (
          <li>
            <a
              href={`/articles/${article.id}/`}
              class="card block transition-shadow hover:shadow-md"
            >
              <h2 class="font-medium text-ink">{article.data.title}</h2>
              <p class="mt-2 text-sm text-ink-muted">{article.data.summary}</p>
              <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-ink-muted">
                <span>{formatDate(article.data.publishedDate)}</span>
                {article.data.tags.length > 0 && (
                  <>
                    <span aria-hidden="true">&middot;</span>
                    {article.data.tags.map((tag) => (
                      <a
                        href={tagUrl(tag)}
                        class="rounded-full border border-border px-2 py-0.5 hover:border-accent hover:text-accent"
                      >
                        {tag.replace(/-/g, ' ')}
                      </a>
                    ))}
                  </>
                )}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
