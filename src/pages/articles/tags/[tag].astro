---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../../config/site';
import { formatDate, getAllArticleTags } from '../../../lib/content';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter((a) => !a.data.draft);
  const tags = getAllArticleTags(articles);

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      articles: articles
        .filter((a) => a.data.tags.includes(tag))
        .sort(
          (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime(),
        ),
    },
  }));
}

const { tag, articles } = Astro.props;
const tagLabel = tag.replace(/-/g, ' ');
---

<BaseLayout
  title={`${tagLabel} articles | ${site.name}`}
  description={`VBA guides tagged “${tagLabel}” on ${site.name}.`}
>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">
      <a href="/articles/" class="hover:underline">
        Articles
      </a>
    </p>
    <h1 class="mt-2 font-display text-3xl font-bold capitalize tracking-tight text-ink sm:text-4xl">
      {tagLabel}
    </h1>
    <p class="mt-4 text-lg text-ink-muted">
      {articles.length} article{articles.length === 1 ? '' : 's'} in this topic.
    </p>

    <ul class="mt-10 space-y-4">
      {
        articles.map((article) => (
          <li>
            <a
              href={`/articles/${article.id}/`}
              class="card block transition-shadow hover:shadow-md"
            >
              <h2 class="font-medium text-ink">{article.data.title}</h2>
              <p class="mt-2 text-sm text-ink-muted">{article.data.summary}</p>
              <p class="mt-3 text-xs text-ink-muted">
                {formatDate(article.data.publishedDate)}
              </p>
            </a>
          </li>
        ))
      }
    </ul>

    {
      articles.length === 0 && (
        <p class="mt-8 text-ink-muted">
          No articles use this tag yet.{' '}
          <a href="/articles/" class="text-accent hover:underline">
            Browse all articles
          </a>
          .
        </p>
      )
    }
  </section>
</BaseLayout>
