---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout
  title={`Search | ${site.name}`}
  description="Search Decoding VBA lessons, articles, and course pages."
>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      Search
    </h1>
    <p class="mt-4 text-lg text-ink-muted">
      Find lessons, articles, and guides across Decoding VBA.
    </p>

    <div id="search" class="mt-10"></div>

    <p class="mt-8 text-sm text-ink-muted">
      Search indexes site content at build time. Run <code class="rounded bg-accent-soft px-1.5 py-0.5 text-accent">npm run build && npm run preview</code> to test locally.
    </p>
  </section>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />

<style is:global>
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #1a6b4a;
    --pagefind-ui-text: #0f1412;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #dce5e0;
    --pagefind-ui-tag: #e6f4ed;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.75rem;
    --pagefind-ui-font: 'Inter', ui-sans-serif, system-ui, sans-serif;
  }
</style>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const mountSearch = () => {
      if (typeof PagefindUI === 'undefined') {
        const notice = document.createElement('p');
        notice.className = 'rounded-xl border border-border bg-accent-soft/50 p-4 text-sm text-ink-muted';
        notice.textContent =
          'Search is available after a production build. Run npm run build, then npm run preview.';
        document.getElementById('search')?.append(notice);
        return;
      }

      // eslint-disable-next-line no-undef
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
      });
    };

    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = mountSearch;
    script.onerror = mountSearch;
    document.body.append(script);
  });
</script>
