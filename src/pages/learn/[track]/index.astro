---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site, tracks } from '../../config/site';
import { getLessonsByTrack, lessonUrl } from '../../lib/content';
import type { Track } from '../../content/config';

export async function getStaticPaths() {
  const tracksList: Track[] = ['beginner', 'intermediate', 'advanced'];
  return tracksList.map((track) => ({ params: { track } }));
}

const { track } = Astro.params as { track: Track };
const allLessons = (await getCollection('lessons')).filter((l) => !l.data.draft);
const trackLessons = getLessonsByTrack(allLessons, track);
const trackInfo = tracks[track];
---

<BaseLayout
  title={`${trackInfo.title} VBA Lessons | ${site.name}`}
  description={trackInfo.description}
>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">
      {trackInfo.title} track
    </p>
    <h1 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      {trackInfo.title} lessons
    </h1>
    <p class="mt-4 text-lg text-ink-muted">{trackInfo.description}</p>

    <ol class="mt-10 space-y-4">
      {
        trackLessons.map((lesson, index) => (
          <li>
            <a
              href={lessonUrl(lesson)}
              class="card flex gap-4 transition-shadow hover:shadow-md"
            >
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent">
                {index + 1}
              </span>
              <div>
                <h2 class="font-medium text-ink">{lesson.data.title}</h2>
                <p class="mt-1 text-sm text-ink-muted">{lesson.data.summary}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="mt-10">
      <a href="/learn/" class="text-sm font-semibold text-accent hover:underline">
        Back to all tracks
      </a>
    </p>
  </section>
</BaseLayout>
