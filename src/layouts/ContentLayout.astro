---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    {
      eyebrow && (
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent">
          {eyebrow}
        </p>
      )
    }
    <h1 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      {title}
    </h1>
    {
      description && (
        <p class="mt-4 text-lg leading-relaxed text-ink-muted">{description}</p>
      )
    }
    <div class="prose-content mt-10">
      <slot />
    </div>
  </article>
</BaseLayout>
